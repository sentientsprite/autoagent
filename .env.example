# Local SkillEval (default) — uses Ollama, no OpenAI account needed
AUTOAGENT_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct

# Optional: cloud OpenAI instead
# AUTOAGENT_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5

# Anthropic (unused by agent.py today; kept for other experiments)
# ANTHROPIC_API_KEY=
