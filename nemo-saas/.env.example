# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Per-tenant envelope encryption key (32 bytes, base64). Rotate annually.
NEMO_TENANT_KMS_KEY=

# Google OAuth (single client; scopes added per connector)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# Optional: Google Places / Maps key for NAP scraping fallback
GOOGLE_MAPS_API_KEY=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LOCAL_AUTOPILOT=

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NEMO_NARRATIVE_MODEL=gpt-4o-mini

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Nemo Local <reports@nemo.local>"

# Crawler worker (Playwright host)
NEMO_CRAWLER_URL=http://localhost:8080

# Optional public URLs for /portal and /team hubs (docs/ACCESS_AND_PORTALS.md)
NEXT_PUBLIC_GROWTHCOACH_STORE_URL=
NEXT_PUBLIC_DGTL_MKTG_ASSIST_URL=
NEXT_PUBLIC_PRANA_OUTBOUND_CRM_URL=
NEXT_PUBLIC_PRANA_DASHBOARD_URL=
NEXT_PUBLIC_TRADING_DASHBOARD_URL=
NEXT_PUBLIC_HUNTER_CONSOLE_URL=

