# PinchTab browser automation — adjust path to match your PinchTab API
PINCHTAB_BASE_URL=http://127.0.0.1:9867

# Web (database optional for lead capture v1 — use direct API route without DB first)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spryte
