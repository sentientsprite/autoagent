# Anthropic — primary auditor LLM
ANTHROPIC_API_KEY=

# Claude model (Haiku-class; override when Anthropic bumps versions)
SPRITE_ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# MLX / mac-code OpenAI-compatible server fallback
MLX_BASE_URL=http://127.0.0.1:8000/v1
